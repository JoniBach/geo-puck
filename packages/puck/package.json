{
	"name": "@jonibach/geo-puck",
	"version": "0.1.1",
	"description": "Any place on Earth as a terrain diorama on a compass plinth: Svelte components (Three.js through Threlte) with live heights, imagery, map lines, sun, moon and weather, and layers of your own, such as a generative forest.",
	"license": "MIT",
	"author": "JoniBach",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoniBach/geo-puck.git",
		"directory": "packages/puck"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@jonibach/geo-puck-data": "^0.1.1"
	},
	"peerDependencies": {
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"svelte": "^5.56.1",
		"three": ">=0.186.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.0",
		"@types/three": "^0.186.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"three": "^0.186.1",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
